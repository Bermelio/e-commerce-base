{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "@components/*": [
        "./src/components/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@interface/*": [
        "./src/interface/*"
      ],
      "@lib/*":[
        "./src/lib/*"
      ],
      "@consts/*": [
        "./src/consts/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}