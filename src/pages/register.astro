---
import RootMain from "@layouts/rootMain.astro"
import Navbar from "@components/Navbar.astro"
---
<RootMain title="Register | A" description="Register page for my page jeje">
  <>
    <Navbar />
    <h2 class="text-8xl flex pl-14">Register</h2>
    
    <p class="text-center">Already have an account? <a href="/signin">Sign in</a></p>
    <div class="flex">
      <form 
      action="/api/auth/register" 
      method="post"
      class="max-w-md mx-auto bg-white shadow-xl rounded-2xl p-8 space-y-6"
    >

  <h2 class="text-3xl font-bold text-center text-gray-800">
    Create Account
  </h2>

  <div class="flex flex-col space-y-2">
    <label for="email" class="text-sm font-semibold text-gray-600">
      Email
    </label>
    <input 
      type="email" 
      name="email" 
      id="email"
      required
      class="px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
      placeholder="you@example.com"
    />
  </div>

  <div class="flex flex-col space-y-2">
    <label for="password" class="text-sm font-semibold text-gray-600">
      Password
    </label>
    <input 
      type="password" 
      name="password" 
      id="password"
      required
      class="px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
      placeholder="••••••••"
    />
  </div>

  <button
    type="submit"
    class="w-full bg-blue-soul text-white py-3 rounded-xl font-semibold text-lg 
           hover:bg-blue-900 active:scale-95 transition-all duration-200"
  >
    Register
  </button>

</form>
    </div>
  </>
</RootMain>