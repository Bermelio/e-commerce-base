---
import Navbar from "@components/Navbar.astro"
import RootMain from "@layouts/rootMain.astro"
import { supabase } from "@lib/supabase"
import Background from "@components/Background.astro"

const { tickets } = Astro.params

const { data , error: _error } = await supabase
.from("MatafuegosDB")
.select("*")
.eq('ticket', tickets)
.single()

if(!data){
  return Astro.redirect('/404')
}

const fechaEntregaFormat = new Date(data.fechaEntrega).toLocaleDateString('es-AR')
const fechaRetiroFormat = new Date(data.fechaRetiro).toLocaleDateString('es-AR')
---
<RootMain title=`Ticket ${data.empresa}` description="Ticket del usuario personal | consulta.">
  <Navbar/>
  <div class="flex justify-center items-center min-h-full sm:pt-40 pt-20">
    <div class="shadow p-5 m-3 rounded-md flex flex-col item-center gap-2 sm:text-2xl text-md bg-white">
      <span class="border-b border-gray-200 pb-4 text-center text-gray-300">
        <p>Ticket:</p>
        <p class="text-xl">{tickets}</p>
      </span>
      <span class="border-b border-gray-200 py-4 text-2xl flex flex-col gap-2">
        <div class="flex justify-between items-center">
          <span>Dueño o empresa:</span>
          <span><strong>{data.empresa}</strong></span>
        </div>
        <div class="flex justify-between items-center">
          <span>Unidad/es:</span>
          <span><strong>{data.unidades}</strong></span>
        </div>
        <div class="flex justify-between items-center">
          <span>Clasificación:</span>
          <span><strong>{data.clasificacion}</strong></span>
        </div>
      </span>
      <span class="border-b border-gray-200 py-4 text-2xl">
        <div class="flex justify-between items-center">
          <span>Fecha de entrega:</span>
          <span><strong>{fechaEntregaFormat}</strong></span>
        </div>
        <div class="flex justify-between items-center">
          <span>Fecha de retiro:</span>
          <span><strong>{fechaRetiroFormat}</strong></span>
        </div>
        <div class="flex justify-between items-center">
          <span>Método de pago:</span>
          <span><strong>{data.metodoPago}</strong></span>
        </div>

      </span>
      <span class="flex justify-between items-center text-xl">
        <p>Estado actual:
          {data.estado
        ?<span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse" />
          Listo para retirar</span> 
        :<span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse" />
          Trabajando</span>}
        </p>

      </span>
    </div>
  </div>
  <Background/>
<RootMain/>