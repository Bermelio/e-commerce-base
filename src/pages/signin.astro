---
import RootMain from "@layouts/rootMain.astro"
import Navbar from "@components/Navbar.astro"
---

<RootMain title="Iniciar sesion" description="Inicio de sesion for my page jeje">
  <>
    <Navbar />
    <div class="flex sm:pt-20">
      <form 
      action="/api/auth/signin"
      method="post"
      class="max-w-lg mx-auto shadow-lg rounded-2xl p-10 space-y-6 w-full"
      >
      <h2 class="text-3xl font-bold text-center text-gray-800">
        Login
      </h2>
      <p class="text-center text-lg">No tenes cuenta? <a href="/register" class="text-red-600">Registrate</a></p>

        <div class="flex flex-col space-y-2">
          <label for="email" class="text-sm font-semibold text-gray-600">
            Email
          </label>
          <input 
            type="email" 
            name="email" 
            id="email"
            required
            class="px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
            placeholder="correo@ejemplo.com"
          />
        </div>

        <div class="flex flex-col space-y-2">
          <label for="password" class="text-sm font-semibold text-gray-600">
            Contraseña
          </label>
          <input 
            type="password" 
            name="password" 
            id="password"
            required
            class="px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
            placeholder="••••••••"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-blue-soul text-white py-3 rounded-xl font-semibold text-lg 
              hover:bg-blue-900 active:scale-95 transition-all duration-200"
        >
          Iniciar Sesion
        </button>

      </form>
    </div>
  </>
</RootMain>